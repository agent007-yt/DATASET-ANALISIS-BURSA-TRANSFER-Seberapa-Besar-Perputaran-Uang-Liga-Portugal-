4. Harga Transfer Tidak Selalu Sama dengan Market Value
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

# 1. DATA PEMAIN
data = {
    "Pemain": [
        "Geovany Quenda",
        "Ousmane Diomande",
        "Morten Hjulmand",
        "Francisco Trincão",
        "Amar Dedić",
        "Rodrigo Zalazar",
        "Rodrigo Mora",
        "António Silva"
    ],

    "Fee (€m)": [
        50.78, 40.00, 40.00, 39.35,
        35.90, 30.00, 25.00, 25.00
    ],

    "Market value (€m)": [
        42.00, 42.00, 45.00, 40.00,
        16.00, 30.00, 38.00, 25.00
    ]
}

# 2. MEMBUAT TABEL DAN MENGHITUNG SELISIH
df = pd.DataFrame(data)

df["Selisih (€m)"] = (
    df["Fee (€m)"] - df["Market value (€m)"]
)

# Menghitung persentase premium/discount
df["Premium/Discount"] = (
    df["Selisih (€m)"] / df["Market value (€m)"] * 100
)

# 3. MENAMPILKAN TABEL
tabel = df.copy()

tabel["Selisih (€m)"] = tabel["Selisih (€m)"].map(
    lambda x: f"{x:+.2f}"
)

tabel["Premium/Discount"] = tabel["Premium/Discount"].map(
    lambda x: f"{x:+.1f}%"
)

print("TABEL PERBANDINGAN FEE TRANSFER DAN MARKET VALUE")
display(tabel)

# 4. MENYIAPKAN DATA GRAFIK
pemain = df["Pemain"]
fee = df["Fee (€m)"]
market_value = df["Market value (€m)"]

x = np.arange(len(pemain))
lebar = 0.36

# 5. MEMBUAT GRAFIK BATANG
fig, ax = plt.subplots(figsize=(12, 7))

bar1 = ax.bar(
    x - lebar / 2,
    fee,
    lebar,
    label="Harga transfer"
)

bar2 = ax.bar(
    x + lebar / 2,
    market_value,
    lebar,
    label="Market value"
)

# 6. JUDUL DAN LABEL GRAFIK
ax.set_title(
    "Harga Transfer vs Market Value Sebelum Transfer",
    fontsize=14
)

ax.set_ylabel("€ Juta")
ax.set_xticks(x)
ax.set_xticklabels(
    pemain,
    rotation=35,
    ha="right"
)

ax.legend()
ax.grid(axis="y", alpha=0.25)
ax.set_axisbelow(True)

# Menampilkan nilai di atas batang
ax.bar_label(bar1, fmt="%.2f", padding=2, fontsize=8)
ax.bar_label(bar2, fmt="%.2f", padding=2, fontsize=8)

# 7. MERAPIKAN DAN MENAMPILKAN GRAFIK
plt.tight_layout()
plt.show()
